<%= form_with(model: employee, local: true, class: "row g-3") do |f| %>  
  <% if employee.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% employee.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="col-md-6">
    <%= f.label :first_name, class: "form-label" %>
    <%= f.text_field :first_name, class: "form-control" %>
  </div>
  
  <div class="col-md-6">
    <%= f.label :last_name, class: "form-label" %>
    <%= f.text_field :last_name, class: "form-control" %>
  </div>

  <div class="col-md-6">
    <%= f.label :email, "Email Address", class: "form-label" %>
    <%= f.email_field :email, class: "form-control" %>
  </div>

  <div class="col-md-6">
    <%= f.label :designation, class: "form-label" %>
    <%= f.text_field :designation, class: "form-control" %>
  </div>

  <div class="col-md-12">
    <%= f.label :department_id, "Department", class: "form-label" %>
    <%= f.collection_select :department_id, Department.all, :id, :name, 
        { prompt: "Choose..." }, { class: "form-select" } %>
  </div>

  <div class="col-12 mt-4">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", employees_path, class: "btn btn-outline-secondary ms-2" %>
  </div>
<% end %>
