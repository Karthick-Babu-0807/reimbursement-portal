<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Bills List</h1>
    <% if current_user.employee? %>
      <%= link_to 'Add New Bill', new_bill_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <div class="row mb-4">
    <div class="col-md-4">
      <div class="card bg-light border-secondary">
        <div class="card-body text-center">
          <h5 class="text-muted">Total Submitted</h5>
          <p class="h3">INR <%= number_with_delimiter(@total_submitted) %></p>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card bg-success text-white shadow-sm">
        <div class="card-body text-center">
          <h5>Total Approved</h5>
          <p class="h3">INR <%= number_with_delimiter(@total_approved) %></p>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card bg-danger text-white shadow-sm">
        <div class="card-body text-center">
          <h5>Total Rejected</h5>
          <p class="h3">INR <%= number_with_delimiter(@total_rejected) %></p>
        </div>
      </div>
    </div>
  </div>

  <table class="table align-middle border table-striped">
    <thead class="table-dark">
      <tr>
        <th>Type</th>
        <th>Amount</th>
        <th>Date of Submission</th>
        <th>Submitted By</th>
        <th>Department</th>
        <th>Status</th>
        <% if current_user.admin? %>
          <th>Actions</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @bills.each do |bill| %>
        <tr>
          <td><%= bill.bill_type.humanize %></td>
          <td><%= number_to_currency(bill.amount, unit: "₹ ") %></td>
          <td><%= bill.created_at.strftime("%d-%m-%Y") %></td>
          <td><%= bill.employee.full_name %></td>
          <td><%= bill.employee.department.name %></td>
          <td>
            <span class="badge <%= status_badge_class(bill.status) %>">
              <%= bill.status.capitalize %>
            </span>
          </td>
          <% if current_user.admin? %>
            <td class="text-nowrap">
              <% if bill.pending? %>
                <div class="d-flex gap-2">
                  <%= button_to 'Approve', approve_bill_path(bill), 
                                method: :patch, 
                                form_class: "d-inline", 
                                class: "btn btn-sm btn-success" %>

                  <%= button_to 'Reject', reject_bill_path(bill), 
                                method: :patch, 
                                form_class: "d-inline", 
                                class: "btn btn-sm btn-danger",
                                onclick: "return confirm('Are you sure you want to reject this bill?')" %>
                </div>
              <% else %>
                <span class="text-muted small">Processed</span>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
